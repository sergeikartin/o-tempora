{
  "name": "@same-sky/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "predev": "npm run paraglide:compile",
    "dev": "vite",
    "prebuild": "npm run paraglide:compile",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run paraglide:compile",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "lint:boundaries": "steiger ./src",
    "pretest": "npm run paraglide:compile",
    "test": "vitest run",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/shared/paraglide --strategy url baseLocale --emit-ts-declarations"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@same-sky/shared-types": "^0.1.0",
    "@sentry/react": "^10.70.0",
    "d3": "^7.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "temporal-polyfill": "^1.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@inlang/paraglide-js": "^2.23.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3": "^7.4.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "steiger": "^0.6.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
