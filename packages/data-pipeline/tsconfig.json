{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "rootDir": "src",
    "types": ["node"]
  },
  "include": [
    "src/fetch/**/*.ts",
    "src/transform/**/*.ts",
    "src/output/**/*.ts",
    "src/profiles/**/*.ts"
  ]
}
