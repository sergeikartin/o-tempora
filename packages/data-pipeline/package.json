{
  "name": "@o-tempora/data-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "fetch": "NODE_USE_ENV_PROXY=1 tsx src/fetch/index.ts",
    "build-data": "tsx src/output/index.ts",
    "publish-data": "tsx src/output/publish.ts",
    "profiles": "NODE_USE_ENV_PROXY=1 tsx src/profiles/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/transform/**/*.test.ts' 'src/output/**/*.test.ts' 'src/fetch/**/*.test.ts' 'src/profiles/**/*.test.ts'",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@google/genai": "^2.31.0",
    "@o-tempora/shared-types": "^0.1.0",
    "htmlparser2": "^10.1.0",
    "openai": "^7.43.0",
    "seek-bzip": "^2.0.0",
    "tldts": "7.4.10"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
