{
  "name": "@o-tempora/data-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "fetch": "NODE_USE_ENV_PROXY=1 node src/fetch/index.ts",
    "build-data": "node src/output/index.ts",
    "publish-data": "node src/output/publish.ts",
    "profiles": "NODE_USE_ENV_PROXY=1 node src/profiles/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/transform/**/*.test.ts' 'src/output/**/*.test.ts' 'src/fetch/**/*.test.ts' 'src/profiles/**/*.test.ts'",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@o-tempora/shared-types": "^0.1.0",
    "node-html-markdown": "^2.0.0",
    "seek-bzip": "^2.0.0",
    "zod": "^4.6.7"
  }
}
