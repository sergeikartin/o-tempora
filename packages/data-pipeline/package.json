{
  "name": "same-sky-data-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "fetch": "NODE_USE_ENV_PROXY=1 tsx fetch/index.ts",
    "build-data": "tsx output/index.ts",
    "publish-data": "tsx output/publish.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test transform/**/*.test.ts output/**/*.test.ts fetch/**/*.test.ts"
  },
  "dependencies": {
    "@same-sky/shared-types": "^0.1.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
